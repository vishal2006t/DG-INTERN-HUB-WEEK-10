# =================================================================
# DG INTERNS HUB - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to '.env' and populate with your local/production values.
# =================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB URI)
# Option A: Local MongoDB Community Server
MONGODB_URI=mongodb://127.0.0.1:27017/dg_interns_hub
# Option B: MongoDB Atlas Cloud Cluster
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/dg_interns_hub?retryWrites=true&w=majority

# JWT Authentication
# Generate a strong 64-character secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_here
JWT_EXPIRES_IN=7d

# CORS Allowed Client / Frontend URLs
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Frontend Vite Public Configuration (Safe to expose to browser)
VITE_API_URL=http://localhost:5000/api
VITE_API_BASE_URL=http://localhost:5000/api

