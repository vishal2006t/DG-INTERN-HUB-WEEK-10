            ],
            "url": {
              "raw": "{{baseUrl}}/users/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "profile"
              ]
            }
          }
        },
        {
          "name": "Security: Wrong Role (Candidate tries to POST job - 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 403 Forbidden', function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Error message mentions role permission', function () {",
                  "    pm.expect(json.message).to.include('Access denied');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{candidateToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Unauthorized Job Posting\",\n  \"company\": \"Hacker Inc\",\n  \"location\": \"Remote\",\n  \"description\": \"Candidate trying to post job\",\n  \"skills\": [\"Hacking\"]\n}"
